{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/download/files/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/files/CloudWasteScanner_3.1.1_universal.dmg",
      "destination": "https://github.com/ken-water/cloud-waste-scanner-community/releases/download/v3.1.1/target_universal-apple-darwin_release_bundle_dmg_CloudWasteScanner_3.1.1_universal.dmg",
      "permanent": false
    },
    {
      "source": "/download/files/CloudWasteScanner_3.1.1_universal.dmg",
      "destination": "https://github.com/ken-water/cloud-waste-scanner-community/releases/download/v3.1.1/target_universal-apple-darwin_release_bundle_dmg_CloudWasteScanner_3.1.1_universal.dmg",
      "permanent": false
    },
    {
      "source": "/files/(.*)",
      "destination": "/download/files/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.cloud-waste-scanner.com"
        }
      ],
      "destination": "https://cloud-waste-scanner.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/download",
      "destination": "/download/index.html"
    }
  ]
}
